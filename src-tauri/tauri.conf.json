{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "frontend",
  "version": "0.1.0",
  "identifier": "com.tmp.dev",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "frontend",
        "width": 1300,
        "height": 900,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "center": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "opencrab"
        ]
      }
    }
  }
}
