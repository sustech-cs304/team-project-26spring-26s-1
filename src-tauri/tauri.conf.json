{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "OpenCrab",
  "version": "0.1.0",
  "identifier": "tech.opencrabsus",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "OpenCrab",
        "devtools": true,
        "width": 1300,
        "height": 900,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "center": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/python-runtime": "python-runtime"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "opencrab"
        ]
      }
    }
  }
}
